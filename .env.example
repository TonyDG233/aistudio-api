# aistudio-api 环境变量配置
# 复制此文件为 .env 并按需修改

# ========== 服务基础配置 ==========
# HTTP 服务监听端口
AISTUDIO_PORT=8080
# Web 管理控制台访问密码（设置后访问 / 自动启用登录拦截）
AISTUDIO_WEB_PASSWORD=
# AISTUDIO_ADMIN_PASSWORD=

# ========== 浏览器运行时 ==========
# Chromium 远程调试端口 (CDP)
AISTUDIO_BROWSER_PORT=9222
# 浏览器无头模式（1=无头，0=有头调试）
AISTUDIO_BROWSER_HEADLESS=1
# Chromium 可执行文件绝对路径（留空自动探测系统安装的 Chrome/Chromium）
AISTUDIO_BROWSER_EXECUTABLE=

# ========== 网络代理与凭据 ==========
# HTTP / SOCKS5 出口代理（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）
AISTUDIO_PROXY=
# 主数据持久化根目录（留空默认使用 data/）
AISTUDIO_DATA_DIR=
# 账号凭据存储目录（留空默认使用 data/accounts）
AISTUDIO_ACCOUNTS_DIR=
# 模型调用与 Token 使用量统计持久化文件（留空默认使用 data/stats.json）
AISTUDIO_STATS_FILE=
# 账号调度与 429 冷却状态持久化文件（留空默认使用 data/rotator_state.json）
AISTUDIO_ROTATOR_STATE_FILE=
# 自定义 config.yaml 配置文件路径（留空默认使用项目根目录 config.yaml）
AISTUDIO_CONFIG_FILE=
# 认证文件路径（可选，单文件调试或导入时覆盖使用）
AISTUDIO_AUTH_FILE=
# 是否持久化模型调用与 Token 统计（1=开启，0=关闭）
AISTUDIO_PERSIST_STATS=1
# 是否持久化账号调度与 429 冷却状态（1=开启，0=关闭）
AISTUDIO_PERSIST_ROTATOR=1
# 临时文件目录（留空自动获取系统临时目录）
AISTUDIO_TMP_DIR=
# ========== 模型默认行为 ==========
AISTUDIO_DEFAULT_TEXT_MODEL=gemini-3.7-flash
AISTUDIO_DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ========== 超时与缓存控制 ==========
# 请求重放超时（秒）
AISTUDIO_TIMEOUT_REPLAY=120
# 流式传输响应超时（秒）
AISTUDIO_TIMEOUT_STREAM=120
# ========== 账号调度与重试 ==========

# ========== 功能开关 (features) 环境基线 ==========
# 说明：下方变量仅作为启动时的基线兜底；运行时以 config.yaml 顶层 features 段为准
# (可在 Web 控制台可视化编辑并热重载)，优先级 features.* > AISTUDIO_* > 内置默认。
# Build 页面直连面总开关 (on/off，默认 off)：free 档账号走 Build 直连通道
AISTUDIO_BUILD_SURFACE=0
# ATG 防截断模式 (off/prefer/required，默认 off)：合成 function-call 通道承载答案
AISTUDIO_ATG_MODE=off
# 批量账号信息刷新并发工作池大小 (默认 3，对齐 Ark REFRESH_CONCURRENCY)
AISTUDIO_ACCOUNT_REFRESH_CONCURRENCY=3
# 是否按账号档位 (tier) 路由到不同面 (on/off，默认 off)
AISTUDIO_ROUTE_BY_TIER=0
# 定时自动切换账号 (on/off，默认 off，对应 Ark ENABLE_AUTO_SWITCH)
AISTUDIO_AUTO_SWITCH=0
# 自动切换周期间隔小时数 (支持小数，最小 0.1，默认 3.0，对齐 Ark AUTO_SWITCH_INTERVAL_HOURS)
AISTUDIO_AUTO_SWITCH_INTERVAL_HOURS=3.0
# 自动刷新 Auth / 凭证回写 auth.json (on/off，默认 on，对应 Ark ENABLE_AUTH_UPDATE)
AISTUDIO_KEEPALIVE_AUTH_UPDATE=1
# 凭证回写周期小时数 (支持小数，最小 0.1，默认 24.0)
AISTUDIO_KEEPALIVE_AUTH_UPDATE_HOURS=24.0
# 自动更新账号信息 tier/email/expired 到 meta (on/off，默认 on)
AISTUDIO_KEEPALIVE_METADATA_REFRESH=1
# 账号信息刷新周期小时数 (支持小数，最小 0.1，默认 24.0)
AISTUDIO_KEEPALIVE_METADATA_REFRESH_HOURS=24.0
# 启动时补刷缺失/过期账号信息 (on/off，默认 on)
AISTUDIO_KEEPALIVE_METADATA_REFRESH_ON_STARTUP=1
# 活跃页轻量活动 (on/off，默认 off；开启后浏览器不会被空闲回收)
AISTUDIO_KEEPALIVE_ACTIVE_ACTIVITY=0
# 活跃页活动间隔秒数 (最小 10，默认 60)
AISTUDIO_KEEPALIVE_ACTIVE_ACTIVITY_SECONDS=60.0

# ========== 调试输出 ==========
# 是否导出原始底层响应报文（1=开启，0=关闭）
AISTUDIO_DUMP_RAW_RESPONSE=0
# 原始报文导出目录
AISTUDIO_DUMP_RAW_RESPONSE_DIR=
