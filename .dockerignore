# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
*.egg-info
dist
build
.pytest_cache

# Environment (use .env.example as reference, mount .env at runtime)
.env
.env.local

# Local runtime config (may contain api_keys; images bootstrap from defaults/config.yaml)
config.yaml

# Logs
*.log
server.log
server.pid

# Test files
test_*.py
tests/

# Temporary files
/tmp
snapshot_*.log

# Runtime data and local dumps (never bake personal accounts/logs into the image)
data/
data2/
dumps/
server-logs/

# Local virtualenvs
.venv/
venv/

# Frontend dependencies and Android sources (not part of the backend image)
web/node_modules/
android/

# Agent/tooling scratch space
.kilo/
tools/reverse/

# Chrome/Chromium profiles (not needed in container)
chromium-profile/

# Botguard fork (not needed for main service)
botguard-fork/

# waa-signer local build artifacts (rebuilt inside the Docker build stage)
waa-signer/.deps/
waa-signer/bin/

# Documentation
docs/
*.md
!README.md

# Development scripts (only the verify_required cleanup tool ships in the image)
scripts/*
!scripts/clear_verify_required.sh
!scripts/clear_verify_required.py

# Docker
Dockerfile
docker-compose.yml
.dockerignore
