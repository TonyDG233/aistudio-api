          {
            "functionCall": {
              "name": "get_weather",
              "args": {
                "city": "Paris"
              }
            }
          }
        ]
      },
      {
        "role": "user",
        "parts": [
          {
            "functionResponse": {
              "name": "get_weather",
              "response": {
                "temperature_c": 21,
                "condition": "sunny"
              }
            }
          }
        ]
      }
    ]
